# Copy to .env  (loaded automatically by server.js; real environment variables take precedence)

PORT=3000
# ---- admin (one login page for everybody; see docs/ACCOUNTS.md) ----
# The admin account is created on first start. Logging in with it asks for the password AND then the ADMIN_KEY.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too                # empty = a random password is printed once on the first start
ADMIN_KEY=change-me-to-a-long-random-string # second factor of the admin login (empty = new random key each start)
# ADMIN_SESSION_TTL_HOURS=8                 # admin sessions expire sooner than player sessions (30 days)
# ADMIN_PASSWORD_RESET=1                    # locked out? re-applies ADMIN_PASSWORD to the admin account on start
# ADMIN_KEY_HEADER=1                        # allow the bare X-Admin-Key header (scripts/CI only: key alone = admin)
# ALLOW_GUEST_ROOMS=1                       # let people play online without an account (old behaviour)

# ---- behind a reverse proxy / HTTPS ----
# Number of proxies in front of the app (1 for nginx/Caddy). Leave empty when clients connect directly.
TRUST_PROXY=
# Set to 1 when users reach the site over HTTPS (Secure cookies + HSTS)
COOKIE_SECURE=
# Extra origins allowed to call the API / open WebSockets (comma separated). Same-origin always works.
ALLOWED_ORIGINS=

# ---- running other people's code (see docs/SECURITY.md) ----
SANDBOX=auto                 # auto | bwrap | builtin | off
SANDBOX_STRICT=              # 1 = refuse languages that are not confined by bubblewrap (recommended on the Internet)
ALLOW_LOCAL_RUN=1            # 0 = disable /api/run-bot-move
# /api/run-bot-move needs a logged-in account; per-account budget:
# LOCAL_RUN_PER_MIN=600       # moves per minute
# LOCAL_RUN_PARALLEL=2        # moves running at the same time
# LOCAL_NEW_CODE_PER_MIN=20   # new code versions (compiles) per minute
# MAX_BOT_PROCS=4            # concurrent bot processes for the WHOLE server (default: CPU count)
# MAX_COMPILES=2             # concurrent g++ runs
# SANDBOX_MEM_MB=512  SANDBOX_CPU_SEC=10  SANDBOX_COMPILE_MEM_MB=2048

# ---- limits ----
# MAX_ROOMS=200  MAX_SOCKETS_PER_IP=40

# ---- data ----
# DB_PATH=data/ott.db
# BACKUP_DIR=data/backups  BACKUP_INTERVAL_HOURS=24  BACKUP_KEEP=14
# PYTHON_CMD=python3

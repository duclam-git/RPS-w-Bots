# Copy to .env  (loaded automatically by server.js; real environment variables take precedence)

PORT=3000
# Fixed admin key. Log in, press the key button, enter it ONCE and your account becomes admin.
ADMIN_KEY=change-me-to-a-long-random-string

# ---- behind a reverse proxy / HTTPS ----
# Number of proxies in front of the app (1 for nginx/Caddy). Leave empty when clients connect directly.
TRUST_PROXY=
# Set to 1 when users reach the site over HTTPS (Secure cookies + HSTS)
COOKIE_SECURE=
# Extra origins allowed to call the API / open WebSockets (comma separated). Same-origin always works.
ALLOWED_ORIGINS=

# ---- running other people's code (see docs/SECURITY.md) ----
SANDBOX=auto                 # auto | bwrap | builtin | off
SANDBOX_STRICT=              # 1 = refuse languages that are not confined by bubblewrap (recommended on the Internet)
ALLOW_LOCAL_RUN=1            # 0 = disable /api/run-bot-move
# MAX_BOT_PROCS=4            # concurrent bot processes for the WHOLE server (default: CPU count)
# MAX_COMPILES=2             # concurrent g++ runs
# SANDBOX_MEM_MB=512  SANDBOX_CPU_SEC=10  SANDBOX_COMPILE_MEM_MB=2048

# ---- limits ----
# MAX_ROOMS=200  MAX_SOCKETS_PER_IP=40

# ---- data ----
# DB_PATH=data/ott.db
# BACKUP_DIR=data/backups  BACKUP_INTERVAL_HOURS=24  BACKUP_KEEP=14
# PYTHON_CMD=python3
